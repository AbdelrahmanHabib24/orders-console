# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/orders_console?schema=public
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/orders_console_test?schema=public

# Authentication Security
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars-long
ALLOWED_ORIGINS=http://localhost:5173
